# Docker Compose / CodeWiki LLM（知识库社区摘要 + 实体 Embedding 必填）
# 复制为仓库根目录 .env：copy .env.example .env
# 注意：model 若含 "/"，CodeWiki 会原样传给 LiteLLM（忽略 PROVIDER_TYPE）

CODEWIKI_LLM__MODE=sdk
CODEWIKI_LLM__DEFAULT__PROVIDER_TYPE=
CODEWIKI_LLM__DEFAULT__MODEL=openrouter/deepseek/deepseek-v4-flash
CODEWIKI_LLM__DEFAULT__ENDPOINT=https://openrouter.ai/api/v1
CODEWIKI_LLM__DEFAULT__API_KEY=

# OpenRouter 嵌入须带 openrouter/ 前缀；API Key 勿留空（可与 DEFAULT 相同）
# Qwen3-Embedding-4B = 2560 dims（需 halfvec HNSW；见 CODEWIKI_PGVECTOR_HALFVEC）
# 8B=4096 超出 halfvec HNSW 上限 4000，勿用。也可用 openrouter/openai/text-embedding-3-small (1536)
CODEWIKI_LLM__PROFILES__EMBEDDING__PROVIDER_TYPE=
CODEWIKI_LLM__PROFILES__EMBEDDING__MODEL=openrouter/qwen/qwen3-embedding-4b
CODEWIKI_LLM__PROFILES__EMBEDDING__ENDPOINT=https://openrouter.ai/api/v1
CODEWIKI_LLM__PROFILES__EMBEDDING__API_KEY=

CODEWIKI_INCLUDE_EMBEDDINGS=true
CODEWIKI_COMMUNITY_ALGORITHM=leiden
# auto: dims>2000 用 halfvec；always/never 强制开关（pgvector HNSW: vector≤2000, halfvec≤4000）
CODEWIKI_PGVECTOR_HALFVEC=auto

# Container-local build/query JSONL under /app/storage/logs (1=on)
CODEWIKI_OPS_TRACE=1
CODEWIKI_OPS_TRACE_CONTENT_CHARS=12000
