GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/auth/callback
FRONTEND_URL=http://localhost:5173

# OpenRouter LLM（智能问答 + Issue 分析增强）
# 在 https://openrouter.ai/keys 创建 API Key，复制 backend/.env.example 为 backend/.env 后填入真实值：
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=tencent/hy3:free
# OpenRouter 可选站点信息（推荐填写）
LLM_HTTP_REFERER=http://localhost:5173
LLM_APP_TITLE=RepoPilot
