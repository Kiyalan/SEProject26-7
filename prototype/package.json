{
  "name": "prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "setup:backend": "uv sync --directory backend",
    "dev:backend": "uv run --directory backend uvicorn main:app --reload --port 8000",
    "kill:ports": "powershell -ExecutionPolicy Bypass -File scripts/restart-dev.ps1",
    "restart:backend": "powershell -ExecutionPolicy Bypass -File scripts/restart-dev.ps1 && npm run dev:backend",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@primer/css": "^22.3.0",
    "@primer/octicons-react": "^19.29.1",
    "antd": "^6.5.0",
    "dayjs": "^1.11.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
