# Copy to perf/.env (gitignored) before running performance tests.
# Bypass the frontend GitHub OAuth UI: mint a JWT with the same secret as the backend.

# Backend under test
BASE_URL=http://localhost:8000

# Must match backend JWT_SECRET (empty => backend pads empty key; prefer a real secret).
# Default when unset in application.yml: repopilot-jwt-secret-change-in-production
JWT_SECRET=repopilot-jwt-secret-change-in-production

# GitHub login name + personal access token (repo scope). Embedded into JWT as github_token.
GITHUB_USERNAME=your-github-login
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: skip minting and paste a JWT captured after one OAuth login
# JWT_TOKEN=

# Load profile
LOOPS=5
RAMP_UP_1=1
RAMP_UP_10=5
INCLUDE_CHAT=true
HTTP_TIMEOUT_MS=120000
