GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/auth/callback

# 生产环境应改为实际前端的 URL（如 https://yourdomain.com），用于 CORS 配置
FRONTEND_URL=http://localhost:5173

# JWT 配置 — 生产环境务必使用强随机字符串
JWT_SECRET=
JWT_EXPIRATION_HOURS=168

# 复制为 backend/.env 并填入真实值后即可本地演示

LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-oss-20b:free
LLM_HTTP_REFERER=http://localhost:5173
LLM_APP_TITLE=RepoPilot
